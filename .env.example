PORT=3000
API_KEY=your_secret_api_key_here

# DATABASE_URL: Transaction Pooling (Port 6543)
DATABASE_URL="postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Session Mode (Port 5432)
DIRECT_URL="postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Email Finder — Verification/search API Keys
EMAILLISTVERIFY_API_KEY=your_emaillistverify_key_here
DEBOUNCE_API_KEY=your_debounce_key_here
SERPER_API_KEY=your_serper_key_here

# DeepSeek — used by /copy and /explore endpoints
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional — CORS/rate limiting (see src/app.ts)
# ALLOWED_ORIGINS=https://example.com,https://app.example.com
# RATE_LIMIT_PER_MIN=60
# COSTLY_RATE_LIMIT_PER_MIN=10
# Optional: override the default DeepSeek model (default: deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash

# Slack — daily provider credit alerts (src/jobs/credit-check-schedule.ts)
SLACK_TOKEN=xoxb-your-bot-token
SLACK_ALERT_CHANNEL=C0XXXXXXXXX
# Set to "true" to arm the daily in-process credit check (off by default so a
# local server never posts to the team's Slack channel just by starting)
CREDIT_CHECK_DAILY=false
# Optional — when the daily check runs, in UTC (default 14:00 = 08:00 CDMX)
# CREDIT_CHECK_HOUR_UTC=14
# CREDIT_CHECK_MINUTE_UTC=0
# Optional — DeBounce caps CONCURRENT calls per account (not request rate).
# Measured ceiling is ~4; default 2 leaves headroom for a local run competing
# with the deployed service for the same slots.
# DEBOUNCE_MAX_CONCURRENT=2
# Optional — how many candidates per /find may escalate to Tier 2 (default 2).
# Tier 1 still checks every permutation; this only bounds the Tier 2 fan-out,
# which otherwise saturates DeBounce's per-account concurrency limit.
# TIER2_BUDGET_PER_SEARCH=2
# Optional — how many calls may WAIT for those slots before Tier 2 is skipped
# (default 40). The semaphore was right; the unbounded queue behind it was not:
# a burst built a line that drained slower than it grew, and the median
# catch_all answer took 72 minutes. Past this depth the call is dropped rather
# than parked, and the search finishes on Tier 1.
# DEBOUNCE_MAX_QUEUE=40

# ─── Email finder budgets ─────────────────────────────────────────────
# Candidates one /find may pay to verify (default 5). Replayed over 119,981
# known-good addresses, 3 candidates on the right surname beat the 15 this
# used to be, and 5 reach 66.8%. Candidates 6-15 add 4 points for twice the
# spend.
# MAX_PERMUTATIONS=5
# Evidence needed before a domain's pattern is trusted enough to verify a
# single address instead of scanning (default 3 samples).
# PATTERN_MIN_SAMPLES=3
# Hard wall-clock budget per /find, in ms (default 20000). Answers delivered
# inside 30s were used 99.3% of the time; answers over an hour, 29.4%.
# FIND_TIME_BUDGET_MS=20000
# Circuit breaker for domains that never answer (default: mute after 10
# fruitless searches, for 30 days). 6,889 such domains cost $135 in four weeks.
# DOMAIN_MUTE_AFTER=10
# DOMAIN_MUTE_DAYS=30
# How long a Serper lookup for a domain is reused (default 30 days).
# SERP_CACHE_TTL_SECONDS=2592000
# Batch jobs: parallel searches per job, and max items per job.
# FIND_JOB_CONCURRENCY=3
# FIND_JOB_MAX_ITEMS=1000

# ─── Finder quality alerts (daily, alongside the credit check) ────────
# Slack fires when the finder is funded and up but wrong or too late.
# QUALITY_MIN_CATCHALL_AGREEMENT=0.6
# QUALITY_MIN_VALID_AGREEMENT=0.85
# QUALITY_MAX_P50_MS=30000
# QUALITY_MIN_COMPARABLE=40
# Optional — runway thresholds in days (default red<3, yellow<10)
# CREDIT_ALERT_RED_DAYS=3
# CREDIT_ALERT_YELLOW_DAYS=10
# Optional — USD floors for DeepSeek, whose spend we don't log (default 5 / 20)
# CREDIT_ALERT_RED_USD=5
# CREDIT_ALERT_YELLOW_USD=20
