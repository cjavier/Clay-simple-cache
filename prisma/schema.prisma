generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id            String   @id @default(uuid()) @db.Uuid
  email         String?  @unique
  linkedin_slug String?  @unique
  linkedin_url  String?  @unique
  phone_e164    String?  @unique
  data          Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@map("profiles")
}

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  domain        String?  @unique
  linkedin_slug String?  @unique
  data          Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@map("companies")
}

// ─── Do Not Contact (DNC) ──────────────────────────────────

model Client {
  id         String   @id @default(uuid()) @db.Uuid
  handle     String   @unique
  name       String
  data       Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  dnc_entries DncEntry[]

  @@map("clients")
}

model DncEntry {
  id         String   @id @default(uuid()) @db.Uuid
  client_id  String   @db.Uuid
  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  list_type  String // 'individual' | 'domain'
  email      String? // original email submitted (lowercased), if any
  domain     String? // blocked domain (for domain-type entries)
  // Stable per-entry fingerprint ("list_type|email|domain"). Nullable email/
  // domain make a composite unique constraint unreliable on Postgres (NULLs
  // are distinct), so this non-null key backs the dedup guarantee instead.
  dedup_key  String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([client_id, dedup_key])
  @@index([client_id])
  @@index([email])
  @@index([domain])
  @@map("dnc_entries")
}

// ─── Email Finder ───────────────────────────────────────────

model VerificationCache {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  status      String
  confidence  Float    @default(0.0)
  method      String?
  verified_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at  DateTime @db.Timestamptz(6)

  @@map("verification_cache")
}

model DomainPattern {
  id             String   @id @default(uuid()) @db.Uuid
  domain         String
  pattern        String
  confidence     Float    @default(1.0)
  sample_count   Int      @default(1)
  last_confirmed DateTime @default(now()) @db.Timestamptz(6)

  @@unique([domain, pattern])
  @@map("domain_patterns")
}

model DomainIntel {
  id               String   @id @default(uuid()) @db.Uuid
  domain           String   @unique
  has_mx           Boolean  @default(false)
  mx_records       Json     @default("[]")
  provider         String   @default("other")
  is_catch_all     Boolean  @default(false)
  is_disposable    Boolean  @default(false)
  is_free_provider Boolean  @default(false)
  checked_at       DateTime @default(now()) @db.Timestamptz(6)
  expires_at       DateTime @db.Timestamptz(6)

  @@map("domain_intel")
}

model SearchLog {
  id                 String   @id @default(uuid()) @db.Uuid
  first_name         String?
  last_name          String?
  domain             String?
  result_email       String?
  result_status      String?
  method_used        String?
  permutations_tried Int      @default(0)
  api_calls_made     Int      @default(0)
  cost_usd           Float    @default(0.0)
  duration_ms        Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([domain])
  @@map("search_log")
}

// ─── Provider Credit Monitor ────────────────────────────────

// One row per provider per check. Kept as history rather than a single
// current-state row so we can see burn rate over time and, more immediately,
// compare a check against the previous one — that's what lets the daily job
// stay quiet while nothing changes and still announce a recovery.
model ProviderCredit {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  status     String // 'green' | 'yellow' | 'red'
  balance    Float? // credits or USD, see `unit`; null when unreadable
  unit       String // 'credits' | 'usd' | 'unknown'
  days_left  Float? // balance / measured daily burn, when burn is known
  error      String? // set when the provider couldn't be read at all
  raw        Json     @default("{}")
  checked_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([provider, checked_at])
  @@map("provider_credits")
}

// ─── Email Finder: caches and guard rails ───────────────────

// SERP results keyed by DOMAIN, not by search.
//
// `searchSerpForEmails()` used to run on every single /find call, so 192,986
// searches over 53,426 distinct domains bought the same Google page 139,560
// times — $139.56 of duplicate calls — and it ran BEFORE the verification-cache
// check, so even a free cache hit paid Serper first.
model SerpCache {
  id         String   @id @default(uuid()) @db.Uuid
  domain     String   @unique
  emails     Json     @default("[]")
  patterns   Json     @default("[]")
  checked_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  @@map("serp_cache")
}

// Per-domain hit rate, so a domain that never answers stops being asked.
//
// 6,889 domains accumulated 14,786 searches and $135.02 without ever returning
// a single `valid` or `catch_all` — banks and large corporates behind anti-spam
// gateways, where SMTP probing simply never replies. `muted_until` is a
// circuit breaker: after MUTE_AFTER consecutive fruitless searches the domain
// answers `unknown` for free, and re-opens once the mute expires so a domain
// that changes its mail setup isn't blacklisted forever.
model DomainHealth {
  domain      String    @id
  searches    Int       @default(0)
  hits        Int       @default(0)
  last_hit_at DateTime? @db.Timestamptz(6)
  muted_until DateTime? @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  @@map("domain_health")
}

// Async batch jobs for /find.
//
// A synchronous /find that answers in 40 minutes has already lost its caller:
// answers delivered under 30s landed in `profiles` 99.3% of the time, answers
// over an hour only 29.4%. A job the caller polls removes the timeout race
// entirely — the work is never thrown away because nobody was still listening.
model FindJob {
  id         String   @id @default(uuid()) @db.Uuid
  status     String   @default("queued") // queued | running | done | failed
  total      Int      @default(0)
  completed  Int      @default(0)
  requests   Json     @default("[]")
  results    Json     @default("[]")
  error      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("find_jobs")
}
