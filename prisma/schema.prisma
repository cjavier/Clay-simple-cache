generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id            String   @id @default(uuid()) @db.Uuid
  email         String?  @unique
  linkedin_slug String?  @unique
  linkedin_url  String?  @unique
  phone_e164    String?  @unique
  data          Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@map("profiles")
}

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  domain        String?  @unique
  linkedin_slug String?  @unique
  data          Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@map("companies")
}

// ─── Do Not Contact (DNC) ──────────────────────────────────

model Client {
  id         String   @id @default(uuid()) @db.Uuid
  handle     String   @unique
  name       String
  data       Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  dnc_entries DncEntry[]

  @@map("clients")
}

model DncEntry {
  id         String   @id @default(uuid()) @db.Uuid
  client_id  String   @db.Uuid
  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  list_type  String // 'individual' | 'domain'
  email      String? // original email submitted (lowercased), if any
  domain     String? // blocked domain (for domain-type entries)
  // Stable per-entry fingerprint ("list_type|email|domain"). Nullable email/
  // domain make a composite unique constraint unreliable on Postgres (NULLs
  // are distinct), so this non-null key backs the dedup guarantee instead.
  dedup_key  String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([client_id, dedup_key])
  @@index([client_id])
  @@index([email])
  @@index([domain])
  @@map("dnc_entries")
}

// ─── Email Finder ───────────────────────────────────────────

model VerificationCache {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  status      String
  confidence  Float    @default(0.0)
  method      String?
  verified_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at  DateTime @db.Timestamptz(6)

  @@map("verification_cache")
}

model DomainPattern {
  id             String   @id @default(uuid()) @db.Uuid
  domain         String
  pattern        String
  confidence     Float    @default(1.0)
  sample_count   Int      @default(1)
  last_confirmed DateTime @default(now()) @db.Timestamptz(6)

  @@unique([domain, pattern])
  @@map("domain_patterns")
}

model DomainIntel {
  id               String   @id @default(uuid()) @db.Uuid
  domain           String   @unique
  has_mx           Boolean  @default(false)
  mx_records       Json     @default("[]")
  provider         String   @default("other")
  is_catch_all     Boolean  @default(false)
  is_disposable    Boolean  @default(false)
  is_free_provider Boolean  @default(false)
  checked_at       DateTime @default(now()) @db.Timestamptz(6)
  expires_at       DateTime @db.Timestamptz(6)

  @@map("domain_intel")
}

model SearchLog {
  id                 String   @id @default(uuid()) @db.Uuid
  first_name         String?
  last_name          String?
  domain             String?
  result_email       String?
  result_status      String?
  method_used        String?
  permutations_tried Int      @default(0)
  api_calls_made     Int      @default(0)
  cost_usd           Float    @default(0.0)
  duration_ms        Int      @default(0)
  // Which name we actually spelled the candidates from: 'linkedin' (the
  // paternal surname recovered from the slug), 'full_name', or 'given' (the
  // last_name as sent). Without this column the before/after of the single
  // biggest change is unmeasurable after the fact — the log would show the
  // hit rate moving with no way to attribute it.
  identity_source    String?
  // The search hit its wall-clock budget. A row with this set did not
  // establish that the address doesn't exist, only that we stopped looking,
  // and any accuracy measurement has to exclude it rather than score it as a
  // miss.
  timed_out          Boolean  @default(false)
  // How many candidates the permutator produced before the budget truncated
  // the list. `permutations_tried` is what we paid for; this is what we could
  // have paid for, and the gap is what the budget is actually saving.
  candidates_built   Int      @default(0)
  /// What the caller should do with the answer: send | risky | do_not_send.
  send_recommendation String?
  /// The evidence tier behind that recommendation (see email-finder/outcomes.ts).
  evidence           String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([domain])
  @@index([created_at])
  @@map("search_log")
}

// Daily snapshot of how well the finder is answering.
//
// `provider_credits` keeps history rather than current state so burn rate is
// visible; this is the same idea for quality. `GET /stats` computes the numbers
// live from `search_log` + `profiles`, but that is a point-in-time read over a
// rolling window: once the window slides, today's agreement rate is gone. To
// answer "did the change work?" in a month, the number has to be written down
// on the day it was true.
model FinderMetric {
  id             String   @id @default(uuid()) @db.Uuid
  measured_on    DateTime @db.Date
  window_days    Int      @default(7)
  status         String // 'valid' | 'catch_all' | '_overall'
  answered       Int      @default(0)
  comparable     Int      @default(0)
  agreed         Int      @default(0)
  agreement_rate Float?
  delivered      Int      @default(0)
  delivery_rate  Float?
  searches       Int      @default(0)
  api_calls      Int      @default(0)
  cost_usd       Float    @default(0.0)
  p50_ms         Int?
  p90_ms         Int?
  raw            Json     @default("{}")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([measured_on, window_days, status])
  @@index([measured_on])
  @@map("finder_metrics")
}

// ─── Provider Credit Monitor ────────────────────────────────

// One row per provider per check. Kept as history rather than a single
// current-state row so we can see burn rate over time and, more immediately,
// compare a check against the previous one — that's what lets the daily job
// stay quiet while nothing changes and still announce a recovery.
model ProviderCredit {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  status     String // 'green' | 'yellow' | 'red'
  balance    Float? // credits or USD, see `unit`; null when unreadable
  unit       String // 'credits' | 'usd' | 'unknown'
  days_left  Float? // balance / measured daily burn, when burn is known
  error      String? // set when the provider couldn't be read at all
  raw        Json     @default("{}")
  checked_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([provider, checked_at])
  @@map("provider_credits")
}

// ─── Email Finder: caches and guard rails ───────────────────

// SERP results keyed by DOMAIN, not by search.
//
// `searchSerpForEmails()` used to run on every single /find call, so 192,986
// searches over 53,426 distinct domains bought the same Google page 139,560
// times — $139.56 of duplicate calls — and it ran BEFORE the verification-cache
// check, so even a free cache hit paid Serper first.
model SerpCache {
  id         String   @id @default(uuid()) @db.Uuid
  domain     String   @unique
  emails     Json     @default("[]")
  patterns   Json     @default("[]")
  checked_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  @@map("serp_cache")
}

// Per-domain hit rate, so a domain that never answers stops being asked.
//
// 6,889 domains accumulated 14,786 searches and $135.02 without ever returning
// a single `valid` or `catch_all` — banks and large corporates behind anti-spam
// gateways, where SMTP probing simply never replies. `muted_until` is a
// circuit breaker: after MUTE_AFTER consecutive fruitless searches the domain
// answers `unknown` for free, and re-opens once the mute expires so a domain
// that changes its mail setup isn't blacklisted forever.
model DomainHealth {
  domain      String    @id
  searches    Int       @default(0)
  hits        Int       @default(0)
  last_hit_at DateTime? @db.Timestamptz(6)
  muted_until DateTime? @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  @@map("domain_health")
}

// Async batch jobs for /find.
//
// A synchronous /find that answers in 40 minutes has already lost its caller:
// answers delivered under 30s landed in `profiles` 99.3% of the time, answers
// over an hour only 29.4%. A job the caller polls removes the timeout race
// entirely — the work is never thrown away because nobody was still listening.
model FindJob {
  id         String   @id @default(uuid()) @db.Uuid
  status     String   @default("queued") // queued | running | done | failed
  total      Int      @default(0)
  completed  Int      @default(0)
  requests   Json     @default("[]")
  results    Json     @default("[]")
  error      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("find_jobs")
}

/// A list being built for a MailBridge client: one MailBridge table per kind
/// (companies, people). The tables are created synchronously by POST /tables;
/// the rows arrive later through POST /tables/:id/rows and are forwarded in the
/// background as `TableJobBatch`es, so the caller never waits on MailBridge.
model TableJob {
  id             String          @id @db.Uuid
  mb_client_id   String          @db.Uuid
  mb_client_name String?
  campaign       String
  niche          String
  /// Whatever the caller used to build the list (recipe, provider filters).
  filters        Json            @default("{}")
  /// Where the rows come from, e.g. "blitzapi".
  source         String?
  /// { companies: { table_id, name }, people: { table_id, name } }
  tables         Json            @default("{}")
  /// Background Blitz build (POST /tables with `build`): config, progress, status.
  build          Json?
  build_status   String? // queued | running | done | failed
  build_state    Json            @default("{}")
  build_error    String?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @updatedAt @db.Timestamptz(6)
  batches        TableJobBatch[]

  @@index([mb_client_id])
  @@index([build_status])
  @@map("table_jobs")
}

/// Rows waiting to reach MailBridge. `sending` is transient: a batch stuck in
/// it past STALE_AFTER_MS died with its process and is put back to `pending`.
model TableJobBatch {
  id              String   @id @default(uuid()) @db.Uuid
  job_id          String   @db.Uuid
  job             TableJob @relation(fields: [job_id], references: [id], onDelete: Cascade)
  kind            String // companies | people
  /// Already mapped for MailBridge: [{ ref, data, sources }]
  rows            Json
  row_count       Int
  status          String   @default("pending") // pending | sending | sent | failed
  attempts        Int      @default(0)
  next_attempt_at DateTime @default(now()) @db.Timestamptz(6)
  inserted        Int      @default(0)
  updated         Int      @default(0)
  error           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, next_attempt_at])
  @@index([job_id])
  @@map("table_job_batches")
}

/// What happened when an address was actually mailed, reported by MailBridge.
/// The ground truth the finder grades itself against. See
/// src/email-finder/outcomes.ts.
model EmailOutcome {
  source                String
  source_ref            String
  email                 String
  domain                String
  first_name            String?
  last_name             String?
  linkedin_slug         String?
  pattern               String?
  bounced_at            DateTime? @db.Timestamptz(6)
  bounce_type           String?
  replied_at            DateTime? @db.Timestamptz(6)
  positive_at           DateTime? @db.Timestamptz(6)
  auto_replied          Boolean   @default(false)
  first_visible_send_at DateTime? @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  @@id([source, source_ref])
  @@index([email])
  @@index([domain])
  @@map("email_outcomes")
}

/// Who found an address and who verified it, one row per fact (history, not
/// just the last answer). `finder` and `verifier` are providers; `method` is the
/// decision path and is no longer the provider. Pushed to MailBridge as
/// `found`/`verified` evidence (POST /email-evidence); `pushed_at` is the
/// durable outbox. See src/email-finder/provenance.ts.
model EmailProvenance {
  id          String    @id @db.Uuid
  email       String
  finder      String?
  verifier    String?
  /// valid | invalid | catch_all | unknown | risky
  verdict     String
  /// The status as the pipeline or caller said it (disposable, no_mx…).
  raw_status  String?
  confidence  Float?
  method      String?
  /// find | verify | ingest | backfill_search | backfill_cache
  origin      String
  checked_at  DateTime  @db.Timestamptz(6)
  pushed_at   DateTime? @db.Timestamptz(6)
  push_error  String?
  /// What the finder knew (send_recommendation, evidence_tier, expected_bounce,
  /// mail_gateway, mx_provider, pattern, searched_name); sent as `raw` to MailBridge.
  meta        Json?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email])
  @@index([checked_at])
  @@index([pushed_at, created_at])
  @@index([finder])
  @@index([verifier, verdict])
  @@map("email_provenance")
}

// ─── Email cascade (Blitz → Prospeo → Findymail) — RETIRED 2026-10-09 ───
// Nothing writes these two tables any more: the paid search and verification
// of emails moved to MailBridge's table columns (its spec 109). Kept, with
// their history, on purpose: do not drop them in a migration.

/// One person × one paid email finder: what it answered, or why it couldn't.
/// "No encontrado" (`not_found`: the provider looked and has nothing) is not
/// "no se pudo buscar" (`pending`: no credits, rate limit, error, budget).
/// A `not_found` is not asked again for EMAIL_NOT_FOUND_RETRY_DAYS (90); a
/// `pending` is retried when the reason clears. `closed` = the person was
/// found in the cache (e.g. by Clay's "Get Email (External)") before anyone
/// paid. See src/services/email-cascade/.
model EmailAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  /// li:<slug> or nd:<first>|<last>@<domain>
  person_key     String
  linkedin_url   String?
  first_name     String?
  last_name      String?
  full_name      String?
  company_domain String?
  company_name   String?
  /// Table job (POST /tables) the person belongs to; "" outside a list.
  job_id         String    @default("")
  mb_table_id    String?
  /// The row's ref in that MailBridge table, so a later find upserts the same row.
  row_ref        String?
  /// blitzapi | prospeo | findymail
  provider       String
  /// found | not_found | pending | closed
  status         String
  /// pending: sin_creditos | rate_limit | error | presupuesto · closed: cache
  reason         String?
  email          String?
  cost_usd       Float     @default(0)
  tries          Int       @default(0)
  last_error     String?
  attempted_at   DateTime? @db.Timestamptz(6)
  resolved_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([person_key, provider, job_id])
  @@index([status, provider])
  @@index([job_id, status])
  @@index([person_key])
  @@map("email_attempts")
}

/// Circuit breaker per paid finder, in the database so it survives deploys.
/// `exhausted_at` set = don't call it; the hourly check reads its (free)
/// balance endpoint and clears it when there is money again.
model EmailProviderState {
  provider         String    @id
  exhausted_at     DateTime? @db.Timestamptz(6)
  /// sin_creditos | sin_acceso
  exhausted_reason String?
  exhausted_detail String?
  last_balance     Float?
  last_balance_at  DateTime? @db.Timestamptz(6)
  /// YYYY-MM-DD (CDMX) of the last low-balance alert: one per day per provider.
  low_alert_on     String?
  reactivated_at   DateTime? @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("email_provider_state")
}
